# live-kit service — LiveKit control plane (rooms / tokens / webhooks)
# Copy to `.env` and fill in. AegisBackend points LIVEKIT_SERVICE_URL at this
# service; flip LIVEKIT_PROVIDER here to switch Cloud <-> self-hosted with no
# change to AegisBackend or the web-app.

# --- HTTP server ---
HOST=0.0.0.0
PORT=8003

# --- Provider switch: cloud | selfhosted ---
LIVEKIT_PROVIDER=selfhosted

# --- LiveKit connection (values for the ACTIVE provider) ---
# CLOUD example:
#   LIVEKIT_PROVIDER=cloud
#   LIVEKIT_URL=wss://<your-project>.livekit.cloud
#   LIVEKIT_API_KEY=APIxxxxxxxxxxxx
#   LIVEKIT_API_SECRET=<cloud secret>
#
# SELF-HOSTED example (open-source livekit-server, see live-kit-opensource skill):
#   LIVEKIT_PROVIDER=selfhosted
#   LIVEKIT_URL=ws://localhost:7880          # dev; wss://lk.yourdomain.com behind a TLS proxy in prod
#   LIVEKIT_API_KEY=devkey                   # dev creds from `livekit-server --dev`
#   LIVEKIT_API_SECRET=secret                # use a real generated pair in prod
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Room policy ---
LIVEKIT_ROOM_EMPTY_TIMEOUT_S=300
LIVEKIT_ROOM_MAX_PARTICIPANTS=6
LIVEKIT_TOKEN_TTL_S=14400

# --- Webhook forwarding (optional) ---
# Point the LiveKit server's webhook at this service's POST /webhook; verified
# events are forwarded here. AegisBackend exposes POST /api/meeting/webhook.
# AEGIS_WEBHOOK_URL=http://localhost:8001/api/meeting/webhook
FORWARD_TIMEOUT_S=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_PRETTY=true

# Added Testing Comment
