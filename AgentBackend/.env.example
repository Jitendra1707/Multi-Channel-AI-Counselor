# AgentBackend — env template.
#
# Copy this to `.env` and fill in real values.

# --- HTTP server ---
HOST=0.0.0.0
PORT=8001

# --- LLM (OpenAI-compatible streaming endpoint) ---
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- STT provider switch ---
# "deepgram" → cloud, paid, current default.
# "azure"    → Azure Speech (cloud). Same Azure tenant as Blob /
#              Bot Framework — credentials pool with existing spend.
VOICE_STT_PROVIDER=deepgram

# --- Deepgram STT (used when VOICE_STT_PROVIDER=deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
# Endpointing — how long Deepgram waits after speech ends before
# finalising the transcript. 300ms = latency-first (Twilio default),
# 500ms = conservative for noisy environments.
DEEPGRAM_ENDPOINTING_MS=300

# --- Azure Speech STT (used when VOICE_STT_PROVIDER=azure) ---
# Get the key + region from Azure Portal → Speech service →
# Keys and Endpoint. Region is the short-code (e.g. 'eastus',
# 'centralindia', 'westeurope') — NOT the full hostname.
# AZURE_SPEECH_LANGUAGE is BCP-47 ('en-US', 'en-IN', 'hi-IN', etc.).
# AZURE_SPEECH_ENDPOINT_ID is only for Azure Custom Speech models;
# leave blank to use the base model.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_ENDPOINT_ID=

# --- TTS provider switch ---
# "elevenlabs" → cloud, paid, premium voices (current default).
# "azure"      → Azure Speech neural voices, shares AZURE_SPEECH_KEY /
#                AZURE_SPEECH_REGION above. ~10x cheaper than ElevenLabs.
VOICE_TTS_PROVIDER=elevenlabs

# --- Azure TTS (used when VOICE_TTS_PROVIDER=azure) ---
# Reuses AZURE_SPEECH_KEY + AZURE_SPEECH_REGION from the STT section.
# AZURE_TTS_VOICE: full Azure neural voice id; must match the language.
#   Popular picks:
#     en-US-AriaNeural         (US English, conversational, chat-tuned)
#     en-US-JennyNeural        (US English, natural)
#     en-US-GuyNeural          (US English, male)
#     en-IN-NeerjaNeural       (Indian English, female)
#     en-IN-PrabhatNeural      (Indian English, male)
# Browse the full gallery: https://speech.microsoft.com/portal/voicegallery
AZURE_TTS_VOICE=en-US-AriaNeural
AZURE_TTS_LANGUAGE=en-US
# Rate: "1.0" natural, "1.1" faster, "0.9" slower.
AZURE_TTS_RATE=1.05
# Optional pitch shift (e.g. "+10%", "-5Hz"). Blank = voice default.
AZURE_TTS_PITCH=
# Optional speaking style ("cheerful", "chat", "newscast-casual"…).
# Blank = neutral. Not every voice supports every style.
AZURE_TTS_STYLE=
# Style intensity 0.01..2.0. Blank = style default.
AZURE_TTS_STYLE_DEGREE=

# --- ElevenLabs TTS (used when VOICE_TTS_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Flash = lowest-latency (~75ms first-byte). Turbo (~300ms) is
# slightly more expressive but the 225ms penalty per turn is the
# difference between "feels real-time" and "feels laggy".
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional voice-tuning overrides (leave blank to use per-voice defaults).
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
ELEVENLABS_USE_SPEAKER_BOOST=true

# --- Canonical pipeline audio rate ---
# Shared by every spoken channel (voice, avatar_video) and the STT/TTS factories.
PIPECAT_AUDIO_SAMPLE_RATE=16000

# --- Addressee gate (voice channel) ---
# When true, the voice bot only responds when its name is heard OR
# an imperative verb leads the utterance. Stops it from interrupting
# side-conversations in the meeting. Set to false for 1:1 demos.
VOICE_REQUIRE_ADDRESS=true

# --- Silero VAD (latency-tuned for snappy turn-taking) ---
# stop_secs=0.60 matches LiveKit voice-agent defaults; pairs with the
# min_volume floor below to suppress noise-triggered phantom turn-ends.
VOICE_VAD_START_SECS=0.10
VOICE_VAD_STOP_SECS=0.60
VOICE_VAD_CONFIDENCE=0.65
VOICE_VAD_MIN_VOLUME=0.60

# --- Identity / persona ---
# IDENTITY_NAME is the stem (without .json) of the active persona.
# On boot, agent_backend/llm_agent/identity/<IDENTITY_NAME>.json is
# hydrated from Azure Blob via the three lowercase vars below.
IDENTITY_NAME=aisha-aegis
IDENTITY_FORCE_REFRESH=false

# --- Azure Blob (shared with Node side, lowercase by convention) ---
# container_name/folder_path/<IDENTITY_NAME>.json must exist in your
# Azure Storage account for the boot-time fetcher to find it.
# Leave connection_string blank to skip Azure and use a local JSON
# placed manually under agent_backend/llm_agent/identity/.
connection_string=
container_name=
folder_path=

# --- Episodic memory (Phase 1.6a) ---
# Append-only timeline of conversation observations. NOT in
# the system prompt — queried on-demand by the BM25 retriever (Phase
# 1.6c). Bound the ring-buffer size to cap RAM footprint.
EPISODIC_MAX_RECORDS=2000

# ============================================================================
# COUNSELOR / VOICE PRODUCT (channels: voice / whatsapp / avatar_video)
# All optional — every key has a default in config.py. Only ACS_* +
# PUBLIC_BASE_URL are required to place a real outbound phone call.
# ============================================================================

# NOTE: the counselor brain now shares the SAME LLM as the avatar brain
# (LLM_MODEL / LLM_MAX_TOKENS above) — one channel-agnostic model across
# voice / whatsapp / chat. There are no separate VOICE_LLM_* keys anymore.

# --- Counselor persona (separate from the avatar IDENTITY_NAME above) ---
# Hydrated from the same Azure Blob vars; falls back to the local JSON at
# agent_backend/llm_agent/identity/aisha-counselor.json.
VOICE_IDENTITY_NAME=aisha-counselor

# --- Test data (leads + university JSON; default ./test-data/*.json) ---
# LEADS_FILE=test-data/leads.json
# UNIVERSITY_FILE=test-data/university.json

# --- Voice channel (real PSTN phone call) ---
VOICE_PROVIDER=acs
# PUBLIC_BASE_URL is the HTTPS URL the provider can reach us at (e.g. an ngrok
# tunnel). REQUIRED for outbound calls — ACS dials out, then streams audio back
# to PUBLIC_BASE_URL/api/voice/acs/media.
PUBLIC_BASE_URL=
ACS_CONNECTION_STRING=
ACS_FROM_NUMBER=

# --- Plivo voice provider (alternative to ACS; set VOICE_PROVIDER=plivo) ---
# Answer-URL driven: in the Plivo console create an XML Application with
#   Answer URL = <PUBLIC_BASE_URL>/api/voice/plivo/answer  (method POST)
# and assign your Plivo number to it (that's the inbound wiring). Media streams
# μ-law 8 kHz to <PUBLIC_BASE_URL>/api/voice/plivo/media. Leave blank when using ACS.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# --- WhatsApp channel (ACS Advanced Messaging — BSP in front of Meta) ---
# Reuses ACS_CONNECTION_STRING above (same ACS resource). ACS_WHATSAPP_CHANNEL_ID
# is the GUID from: Portal -> ACS -> Channels -> Add channel -> WhatsApp.
# Inbound arrives via an Event Grid subscription on the ACS resource pointed at
# <PUBLIC_BASE_URL>/channels/whatsapp/webhook (event type
# Microsoft.Communication.AdvancedMessageReceived). Leave blank to mount the
# channel with outbound disabled (webhook still answers the validation handshake).
ACS_WHATSAPP_CHANNEL_ID=

# --- Production-grade voice features (all default OFF — additive) ---
# Turn each on independently; with all off the pipeline is baseline behaviour.
# ENABLE_STREAMING_OPTIMIZATIONS=false
# ENABLE_TURN_DETECTOR=false
# ENABLE_BARGE_IN_MANAGER=false
# ENABLE_SILENCE_MANAGER=false
# ENABLE_SILENCE_RESPONDER=false
# ENABLE_BACKCHANNELS=false
# ENABLE_BOT_ACKNOWLEDGEMENTS=false
# ENABLE_CONVERSATION_STATE=false
# ENABLE_METRICS=false

# --- Meeting channel (LiveKit room: counsellor + candidate + listening agent) ---
# A virtual counselling meeting on LiveKit. Two HUMANS join from the browser; the
# agent joins server-side, listens, answers ONLY when addressed by name, and on
# meeting end flushes the speaker-tagged transcript to the BusinessLayer for DUAL
# analysis (candidate + counsellor). With LIVEKIT_URL unset the channel mounts but
# /api/meeting/schedule returns 503 (graceful degrade like the other channels).
#
# LiveKit Cloud: create a project at https://cloud.livekit.io, then copy:
#   LIVEKIT_URL        — the wss://<project>.livekit.cloud URL
#   LIVEKIT_API_KEY    — project API key
#   LIVEKIT_API_SECRET — project API secret
# Self-host later by pointing LIVEKIT_URL at your own livekit-server (+ coturn);
# nothing else changes.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Public web-app base for the join links the scheduler generates
# (<base>/meeting/<room>?token=...). Defaults to the first FRONTEND_URLS origin.
# MEETING_JOIN_BASE_URL=https://counselor.example.com
# Agent only replies when addressed by name (persona name + aliases). Keep true
# in production so it stays out of the human↔human conversation.
# MEETING_REQUIRE_ADDRESS=true
# Optional one-line AI-presence / recording notice spoken once on first join.
# MEETING_CONSENT_LINE=Hi everyone — I'm an AI assistant sitting in to help with details. This session may be recorded.
#
# SERVICE mode (opt-in, recommended): route rooms/tokens through the live-kit/
# control-plane service so swapping LiveKit Cloud <-> self-hosted open-source is a
# one-place change (flip LIVEKIT_PROVIDER in the live-kit service; AgentBackend
# unchanged). When set, the three LIVEKIT_* vars above are ignored — the service
# owns them. Leave BLANK for DIRECT mode (AgentBackend mints locally; original
# behaviour). The live-kit service must be running (default port 8003).
# LIVEKIT_SERVICE_URL=http://localhost:8003

# --- Logging ---
LOG_LEVEL=INFO
# Set to true for colored human-readable dev output; false for prod JSON.
LOG_PRETTY=true

# ============================================================================
# RAG — Qdrant hybrid retrieval (dense + sparse, RRF) + INGESTION
# ============================================================================
# --- Vector store (query + ingest share these) ---
RAG_QDRANT_URL=http://104.211.229.223:6333
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION=srineedhi-kb
# Optional 2nd collection for general/education-industry KB; blank disables routing.
RAG_QDRANT_GENERAL_COLLECTION=general-kb

# --- Ingestion (the WRITE side: POST /api/resources) ---
# Collection uploaded docs land in (pre-created on the server as dense 3072
# Cosine + sparse IDF).
RAG_INGEST_COLLECTION=ramesh-kb
# Payload stamped on ingested points (tenant blank = single-tenant, no filter).
RAG_INGEST_SOURCE=uploaded
# RAG_INGEST_TENANT=

# PDF parser: "auto" (LlamaParse v2 if key set, else local pypdf) | "llamaparse" | "local".
RAG_PARSER=auto
# LlamaParse v2 (LlamaIndex hosted) — needed for RAG_PARSER=auto/llamaparse on PDFs.
# Get a key at https://cloud.llamaindex.ai. Without it, ingestion falls back to pypdf.
LLAMA_CLOUD_API_KEY=
# v2 tier: fast | cost_effective | agentic | agentic_plus  (agentic = table-aware default)
RAG_LLAMAPARSE_TIER=agentic

# Upload limits (mirror the FE). Up to 500MB; large docs ingest slower.
RAG_MAX_UPLOAD_MB=500
