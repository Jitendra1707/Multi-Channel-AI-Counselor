# ── BusinessLayer configuration ──────────────────────────────────────────────
# Copy to `.env` and adjust. Every value has a safe default; the service boots
# with an empty .env (it just won't be able to call the LLM or AegisBackend).

# --- HTTP server ---
HOST=0.0.0.0
PORT=8002

# --- Database (PostgreSQL via asyncpg) ---
# In Kubernetes inject this as an env var / secret. Format:
#   postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis

# --- AegisBackend (the conversation engine this service drives) ---
AEGIS_BASE_URL=http://localhost:8001
AEGIS_TIMEOUT_S=15

# --- LLM for the post-call analyzer (OpenAI-compatible) ---
# Reuse the same key/endpoint you use for AegisBackend.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
ANALYZER_LLM_MODEL=gpt-4o-mini
ANALYZER_MAX_TOKENS=700

# Lead DATA is loaded manually via sql/seed_leads.sql (the app does not seed).

# --- Web lead extractor (Playwright + LLM navigation) ---
# The site to scrape leads from, and whether Chromium runs headless. Both come
# from here (NOT the CLI). Trigger a run with: POST /extractor/run
EXTRACTOR_URL=
EXTRACTOR_HEADLESS=true
EXTRACTOR_LLM_MODEL=gpt-4o-mini
EXTRACTOR_MAX_STEPS=20
# Optional login for sites behind auth (left blank = no credential injection).
EXTRACTOR_USERNAME=
EXTRACTOR_PASSWORD=
# Extracted leads are upserted (by phone/email) into this JSON array file.
EXTRACTOR_OUTPUT_PATH=./business/data/leads.json

# --- Worker loops (background services) ---
ANALYZER_ENABLED=true
ANALYZER_POLL_SECONDS=15
# WhatsApp/chat has no hangup — a thread is closed & analyzed after this many
# minutes idle. TEXT channels only (they refresh per turn). Set low (e.g. 2) to
# test WhatsApp analysis without waiting.
SESSION_IDLE_CLOSE_MINUTES=5
# VOICE backstop — separate + longer. A call closes on hangup, so this only
# catches a CRASHED call. Voice does NOT refresh per turn, so keep this LONGER
# than your longest call or an in-progress call gets reaped mid-conversation.
VOICE_SESSION_IDLE_CLOSE_MINUTES=30

ACTIONS_ENABLED=true
ACTIONS_POLL_SECONDS=10
ACTIONS_MAX_ATTEMPTS=4

# Dialer is OFF by default — turn it on only when you want the service to
# autonomously place outbound calls against the lead list.
DIALER_ENABLED=false
DIALER_POLL_SECONDS=20
DIALER_MAX_PARALLEL_CALLS=3
DIALER_PACING_SECONDS=5
DIALER_CALL_MAX_ATTEMPTS=3
DIALER_CALL_BACKOFF_MINUTES=120
DIALER_BATCH_SIZE=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_PRETTY=true
